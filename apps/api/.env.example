# Copie para apps/api/.env: o `pnpm dev` lê esse arquivo, se existir, e reinicia a API ao salvá-lo.
# Tudo tem default, então o arquivo é opcional. Variável definida no shell vale mais que a daqui.

# Se mudar, ajuste também o proxy do Vite (apps/web/vite.config.ts), que aponta para a 3000
PORT=3000
MONGO_URI=mongodb://localhost:27017/aeroscan
# fatal, error, warn, info, debug, trace ou silent
LOG_LEVEL=info
# Origens liberadas no CORS e no WebSocket, separadas por vírgula; "null" é o front aberto via file://
CORS_ORIGINS=null

# Log colorido: o padrão é true fora de produção e de teste
# LOG_PRETTY=true
# Pasta do front compilado que a API serve em "/"; o padrão é frontend-dist/ na raiz do repositório
# FRONTEND_DIST_PATH=

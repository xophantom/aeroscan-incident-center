# Lido só pelo docker compose (todas as variáveis têm default; o .env é opcional)
API_PORT=3000
MONGO_PORT=27017
LOG_LEVEL=info

# Fora do Docker, a API e o Vite não leem este arquivo: passe as variáveis pelo shell.
# API: PORT, MONGO_URI, LOG_LEVEL, LOG_PRETTY, FRONTEND_DIST_PATH e CORS_ORIGINS (todas com
# default; CORS_ORIGINS=null libera só o front aberto via file://), ex.:
#   MONGO_URI=mongodb://localhost:27018/aeroscan pnpm dev
# Web: VITE_API_URL no build (vazio = mesma origem, ou localhost:3000 via file://). Front hospedado
# em outro domínio precisa estar em CORS_ORIGINS na API, ex.:
#   VITE_API_URL=https://api.exemplo.com pnpm build:web

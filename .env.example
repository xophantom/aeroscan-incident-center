# Lido pelo docker compose (todas as variáveis têm default; o .env é opcional)
API_PORT=3000
MONGO_PORT=27017
LOG_LEVEL=info

# API rodando fora do Docker (defaults já apontam para o Mongo local)
# PORT=3000
# MONGO_URI=mongodb://localhost:27017/aeroscan
# LOG_PRETTY=true

# Web: URL da API em build/dev. Vazio = mesma origem (ou localhost:3000 via file://)
# VITE_API_URL=http://localhost:3000

# Lido só pelo docker compose (todas as variáveis têm default; o .env é opcional)
API_PORT=3000
# Se mudar, ajuste o MONGO_URI em apps/api/.env para rodar a API fora do Docker
MONGO_PORT=27017
LOG_LEVEL=info

# Fora do Docker, cada app tem o seu, também opcional: apps/api/.env.example (lido pelo pnpm dev)
# e apps/web/.env.example (lido pelo Vite). Variável passada pelo shell vale mais que a do arquivo:
#   MONGO_URI=mongodb://localhost:27018/aeroscan pnpm dev
#   VITE_API_URL=https://api.exemplo.com pnpm build:web
